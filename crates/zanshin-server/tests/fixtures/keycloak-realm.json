{
  "realm": "zanshin",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 600,
  "groups": [
    { "name": "zanshin-admins" },
    { "name": "zanshin-viewers" }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice-pass-123", "temporary": false }],
      "groups": ["/zanshin-admins"]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob-pass-123", "temporary": false }],
      "groups": ["/zanshin-viewers"]
    },
    {
      "username": "carol",
      "email": "carol@example.com",
      "firstName": "Carol",
      "lastName": "Nogroup",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "carol-pass-123", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "zanshin-console",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "zanshin-console-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:7560/console/auth/callback"],
      "webOrigins": ["http://127.0.0.1:7560"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["openid", "profile", "email"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "http://127.0.0.1:7560/console/auth/saml/metadata",
      "name": "zanshin-console-saml",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": true,
      "redirectUris": ["http://127.0.0.1:7560/console/auth/saml/acs"],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml.force.post.binding": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "email",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml_assertion_consumer_url_post": "http://127.0.0.1:7560/console/auth/saml/acs"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": { "user.attribute": "email", "attribute.name": "email", "attribute.nameformat": "Basic" }
        },
        {
          "name": "name",
          "protocol": "saml",
          "protocolMapper": "saml-javascript-mapper",
          "consentRequired": false,
          "config": { "Script": "user.getFirstName() + ' ' + user.getLastName()", "attribute.name": "name", "attribute.nameformat": "Basic", "single": "true" }
        },
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "consentRequired": false,
          "config": { "attribute.name": "groups", "attribute.nameformat": "Basic", "single": "true", "full.path": "false" }
        }
      ]
    }
  ]
}
