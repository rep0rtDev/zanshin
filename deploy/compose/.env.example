# Copy to .env next to docker-compose.yml. Secrets live in ./secrets/<name> (one value per file,
# no trailing newline matters not): postgres_password clickhouse_password jwt_secret
# admin_bootstrap_key database_url backup_s3_secret grafana_admin_password — `./init-secrets.sh` creates them.
ZANSHIN_DOMAIN=liveops.example.com
ACME_EMAIL=ops@example.com
ZANSHIN_IMAGE=ghcr.io/rep0rtdev/zanshin:0.1.0
# Space separated CIDRs allowed to reach /admin/* and /console (default: everyone).
ADMIN_ALLOW_CIDR=10.0.0.0/8 203.0.113.0/24
ZANSHIN_LOG_LEVEL=info
ZANSHIN_RETENTION_DAYS=400
# Optional OTLP/gRPC collector for traces, e.g. http://otel-collector:4317
ZANSHIN_OTLP_ENDPOINT=
# Sizing (see docs/production.md)
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE=1536MB
PG_MEMORY_LIMIT=2g
REDIS_MAXMEMORY=512mb
CH_MEMORY_LIMIT=3g
# Backups: cron schedule (UTC), local retention, optional S3-compatible offsite copy
BACKUP_SCHEDULE=0 3 * * *
BACKUP_KEEP_DAYS=14
BACKUP_S3_URL=
BACKUP_S3_ACCESS_KEY=
