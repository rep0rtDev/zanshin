{
 "uid": "zanshin-overview",
 "title": "Zanshin / Overview",
 "tags": [
  "zanshin"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "instance",
    "label": "Instance",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(zanshin_uptime_seconds, instance)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "w": 24,
    "h": 1,
    "x": 0,
    "y": 0
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Requests / s (HTTP)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(zanshin_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "http",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Requests / s (gRPC)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(zanshin_grpc_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "grpc",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "5xx ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(rate(zanshin_http_requests_total{instance=~\"$instance\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(zanshin_http_requests_total{instance=~\"$instance\"}[$__rate_interval])),1)",
     "legendFormat": "5xx",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "Live connections",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum(zanshin_ws_connections{instance=~\"$instance\"})",
     "legendFormat": "websocket",
     "refId": "A"
    },
    {
     "expr": "sum(zanshin_server_stream_connections{instance=~\"$instance\"})",
     "legendFormat": "grpc streams",
     "refId": "B"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 18,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
