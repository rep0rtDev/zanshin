   "title": "Requests by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(zanshin_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 20
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Latency p50 / p95 / p99 (client API)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(zanshin_http_request_seconds_bucket{instance=~\"$instance\",route=~\"/v1/.*\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(zanshin_http_request_seconds_bucket{instance=~\"$instance\",route=~\"/v1/.*\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(zanshin_http_request_seconds_bucket{instance=~\"$instance\",route=~\"/v1/.*\"}[$__rate_interval])))",
     "legendFormat": "p99",
     "refId": "C"
