{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES5"],
    "module": "none",
    "outFile": "build/zanshin.js",
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "removeComments": false,
    "typeRoots": ["./types"],
    "types": []
  },
  "include": ["types/**/*.d.ts", "src/**/*.ts"]
}
