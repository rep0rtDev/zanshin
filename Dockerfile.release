# syntax=docker/dockerfile:1.7
# Release image assembled from binaries built natively per architecture in release.yml
# (dist/linux-amd64/zanshin, dist/linux-arm64/zanshin). Dockerfile builds from source instead.
FROM debian:bookworm-slim
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME
LABEL org.opencontainers.image.title="zanshin" \
      org.opencontainers.image.description="Zanshin LiveOps server" \
      org.opencontainers.image.source="https://github.com/rep0rtDev/zanshin" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 10001 zanshin
COPY dist/linux-${TARGETARCH}/zanshin /usr/local/bin/zanshin
USER zanshin
EXPOSE 7550 7549
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s CMD curl -fsS http://localhost:7550/healthz || exit 1
ENTRYPOINT ["zanshin"]
